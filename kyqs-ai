#!/usr/bin/env bash
# KyQuickStart AI: connects your servers over SSH, starts the local AI agent you choose with
# PROMPT.md, shows a live dashboard, and builds the handover sheet when the agent exits.
set -euo pipefail

ROOT=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
SSHD=$HOME/.ssh/kyquickstart-ai
CONF=$SSHD/config
KEY=$SSHD/id_ed25519
RUNS=${XDG_STATE_HOME:-$HOME/.local/state}/kyquickstart-ai/runs
AGENTS=(claude codex gemini opencode)

say() { printf '%s\n' "$*"; }
die() {
	printf 'kyqs-ai: %s\n' "$*" >&2
	exit 1
}
confirm() {
	local r
	read -r -p "$1 [y/N] " r
	[[ $r == [yY]* ]]
}
need() { for c; do command -v "$c" >/dev/null || die "missing $c"; done; }

usage() {
	cat <<EOF
usage: kyqs-ai [command]

  start                          Guided start (default): servers, agent, run, handover
  add-host [--prepared] <name> <address> [port] [admin-user]
                                 Prepare a server and pin its host key as ssh alias kyq-<name>.
                                 --prepared: you already ran bin/prepare-host.sh at its console
  hosts                          List configured servers and check each one answers
  put-secret <kyq-alias> <path>  Paste a secret straight onto a server (hidden input), e.g.
                                 a Cloudflare token the agent asked for. Path under /srv/ky/.
  dashboard [run-dir]            Live status board (latest run by default)
  resume                         Restart the agent on the latest run where it left off
  handover [run-dir]             Rebuild the printable handover sheet
  revoke <name> [admin-user]     Remove the agent's access to a server when you are done
EOF
}

ssh_setup() {
	need ssh ssh-keygen ssh-keyscan base64
	umask 077
	mkdir -p "$SSHD"
	if [ ! -f "$KEY" ]; then
		say "Creating an SSH key used only by KyQuickStart AI: $KEY"
		say "A passphrase is recommended; the launcher loads it into ssh-agent for the session."
		ssh-keygen -q -t ed25519 -f "$KEY" -C "kyquickstart-ai@$(hostname)"
	fi
	[ -f "$CONF" ] || cat >"$CONF" <<EOF
# Managed by kyqs-ai. Each server is "ssh kyq-<name>" and logs in as the non-admin kyops user.
Host kyq-*
  User kyops
  IdentityFile $KEY
  IdentitiesOnly yes
  UserKnownHostsFile $SSHD/known_hosts
  StrictHostKeyChecking yes
  BatchMode yes
  ServerAliveInterval 30
EOF
	local main=$HOME/.ssh/config line="Include $CONF"
	if ! grep -qxF "$line" "$main" 2>/dev/null; then
		[ -L "$main" ] && die "$main is a symlink; add this as its first line yourself, then re-run: $line"
		say "So 'ssh kyq-<name>' works for you and the agent, ~/.ssh/config needs this first line:"
		say "  $line"
		confirm "Add it now?" || die "add the line yourself, then re-run"
		{
			printf '%s\n\n' "$line"
			cat "$main" 2>/dev/null || true
		} >"$main.kyqs-ai.tmp"
		mv "$main.kyqs-ai.tmp" "$main"
	fi
}

key_loaded() {
	ssh-keygen -y -P '' -f "$KEY" >/dev/null 2>&1 && return # no passphrase
	local fp
	fp=$(ssh-keygen -lf "$KEY.pub" | awk '{print $2}')
	ssh-add -l 2>/dev/null | grep -qF "$fp" && return
	[ -n "${SSH_AUTH_SOCK:-}" ] || die "the key has a passphrase but no ssh-agent is running; start one (eval \$(ssh-agent)) and re-run"
	say "Loading the KyQuickStart AI key into ssh-agent for 12 hours."
	ssh-add -t 12h "$KEY"
}

host_aliases() { [ -f "$CONF" ] && awk '$1 == "Host" && $2 != "kyq-*" {print $2}' "$CONF"; }

remote_root() { # <alias> <admin> <script>: run a bundled script as root over the admin's own SSH
	local admin=$2 addr port s
	addr=$(ssh -G "$1" | awk '$1 == "hostname" {print $2}')
	port=$(ssh -G "$1" | awk '$1 == "port" {print $2}')
	s=$(base64 <"$3" | tr -d '\n')
	shift 3
	# Everything is base64, so the admin's login shell (bash, fish, ...) cannot reinterpret it.
	ssh -t -p "$port" "$admin@$addr" "sudo sh -c 'echo $s | base64 -d | sh -s -- $*'"
}

add_host() {
	local prepared=
	[ "${1:-}" = --prepared ] && prepared=1 && shift
	[ $# -ge 2 ] || die "usage: kyqs-ai add-host [--prepared] <name> <address> [port] [admin-user]"
	local name=$1 addr=$2 port=${3:-22} admin=${4:-$USER}
	local alias=kyq-$name
	[[ $name =~ ^[a-z0-9][a-z0-9-]{0,30}$ ]] || die "name: lowercase letters, digits and dashes"
	[[ $addr =~ ^[A-Za-z0-9.:-]+$ ]] || die "address: hostname or IP"
	[[ $port =~ ^[0-9]{1,5}$ ]] || die "port: a number"
	[[ $admin =~ ^[A-Za-z0-9._-]+$ ]] || die "admin-user: a login name"
	ssh_setup
	key_loaded
	if ! grep -qx "Host $alias" "$CONF"; then
		printf '\nHost %s\n  HostName %s\n  Port %s\n  HostKeyAlias %s\n' "$alias" "$addr" "$port" "$alias" >>"$CONF"
	fi
	[ "$(ssh -G "$alias" | awk '$1 == "hostname" {print $2}')" = "$addr" ] || die "$alias already points elsewhere; edit $CONF"

	local out='' k
	if [ -n "$prepared" ]; then
		say "1/3  Skipped: kyops was prepared at the server console."
	else
		say "1/3  Creating the non-admin 'kyops' login on $addr, as $admin (sudo will ask for your password)."
		k=$(base64 <"$KEY.pub" | tr -d '\n')
		out=$(remote_root "$alias" "$admin" "$ROOT/bin/prepare-host.sh" "$k" | tee /dev/stderr | tr -d '\r') ||
			die "preparing $addr failed (output above). Fix it and re-run the same command; it is safe to repeat."
	fi

	say "2/3  Pinning the server's SSH host key."
	local want scan tmp got
	want=$(sed -n 's/^KYQ-HOSTKEY //p' <<<"$out")
	scan=$(ssh-keyscan -T 10 -t ed25519 -p "$port" "$addr" 2>/dev/null | grep -v '^#' || true)
	[ -n "$scan" ] || die "no ed25519 host key answered on $addr:$port"
	tmp=$(mktemp)
	awk -v a="$alias" '{print a, $2, $3}' <<<"$scan" >"$tmp"
	got=$(ssh-keygen -lf "$tmp" | awk '{print $2}')
	if [ -z "$want" ]; then
		say "The server did not report its key. Compare by hand on its console:"
		say "  ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub   should show   $got"
		confirm "Does it match?" || {
			rm -f "$tmp"
			die "host key not confirmed; nothing pinned"
		}
	elif [ "$want" != "$got" ]; then
		rm -f "$tmp"
		die "HOST KEY MISMATCH: server says $want, network answered $got. Possible interception; nothing pinned."
	fi
	if ssh-keygen -F "$alias" -f "$SSHD/known_hosts" >/dev/null 2>&1; then
		ssh-keygen -F "$alias" -f "$SSHD/known_hosts" | grep -qF "$(awk '{print $3}' "$tmp")" ||
			{
				rm -f "$tmp"
				die "$alias is pinned to a DIFFERENT key. A changed host key is never accepted; investigate first."
			}
	else
		cat "$tmp" >>"$SSHD/known_hosts"
	fi
	rm -f "$tmp"
	say "     pinned $got"

	say "3/3  Testing the agent's login."
	ssh "$alias" 'printf "%s, docker %s\n" "$(id -un)" "$(docker version --format "{{.Server.Version}}")"' </dev/null ||
		die "kyops cannot log in or reach Docker on $addr"
	say "ready: ssh $alias"
}

hosts() {
	local a any=
	for a in $(host_aliases); do
		any=1
		if ssh -o ConnectTimeout=8 "$a" true </dev/null 2>/dev/null; then say "  ✔ $a"; else say "  ✖ $a (not answering)"; fi
	done
	[ -n "$any" ] || say "  no servers yet: kyqs-ai add-host <name> <address> [port] [admin-user]"
}

# shellcheck disable=SC2029 # the path is validated, then expanded locally on purpose
put_secret() {
	[ $# = 2 ] || die "usage: kyqs-ai put-secret <kyq-alias> </srv/ky/... path>"
	[[ $1 =~ ^kyq-[a-z0-9-]+$ ]] || die "alias must look like kyq-<name>"
	[[ $2 =~ ^/srv/ky/[A-Za-z0-9._/-]+$ && $2 != *..* ]] || die "path must be under /srv/ky/"
	local v
	if [ -t 0 ]; then
		read -r -s -p "Paste the secret (hidden), then Enter: " v
		echo
		[ -n "$v" ] || die "empty secret"
		printf '%s\n' "$v"
	else
		cat
	fi | ssh "$1" "umask 077 && mkdir -p \"\$(dirname '$2')\" && cat > '$2'"
	say "stored on $1 at $2 (mode 0600). The agent can now use it without seeing it."
}

latest_run() {
	local runs=("$RUNS"/*/) last
	last=${runs[${#runs[@]} - 1]} # bash 3.2 (macOS) has no negative indexes
	[ -d "$last" ] || die "no runs yet; start one with: kyqs-ai"
	printf '%s' "${last%/}"
}

launch() { # <agent> <hands-off:yes|no> <run> <kickoff>
	local agent=$1 hands=$2 run=$3 kick=$4
	case $agent in
	claude)
		if [ "$hands" = yes ]; then
			mkdir -p "$run/.claude"
			cat >"$run/.claude/settings.json" <<'EOF'
{
  "permissions": {
    "allow": [
      "Bash(ssh:*)", "Bash(scp:*)", "Bash(git clone:*)", "Bash(git -C:*)", "Bash(git ls-remote:*)",
      "Bash(curl:*)", "Bash(dig:*)", "Bash(getent:*)",
      "Bash(./bin/progress:*)", "Bash(./bin/redact:*)", "Bash(./bin/handover:*)",
      "Read", "Edit", "Write"
    ]
  }
}
EOF
		fi
		(cd "$run" && claude "$kick")
		;;
	codex)
		local approval=on-request
		[ "$hands" = yes ] && approval=never
		(cd "$run" && codex -C "$run" -s workspace-write -c sandbox_workspace_write.network_access=true \
			-a "$approval" "$kick")
		;;
	gemini) (cd "$run" && gemini -i "$kick") ;;
	opencode) (cd "$run" && opencode --prompt "$kick") ;;
	esac
}

dashboard_hint() {
	if [ -n "${TMUX:-}" ]; then
		tmux split-window -h -d -l 45% "'$ROOT/bin/dashboard' '$1'"
		say "Dashboard opened in the right-hand tmux pane."
	else
		say "Live dashboard: open a second terminal and run"
		say "  $ROOT/kyqs-ai dashboard"
		say "(Run kyqs-ai inside tmux next time and it opens beside the agent by itself.)"
	fi
}

finish() {
	local run=$1
	say ""
	say "── agent session ended ──"
	if [ -f "$run/handover.tsv" ]; then
		"$ROOT/bin/handover" "$run" || true
		if [ -f "$run/handover.txt" ]; then
			confirm "Show the handover sheet (passwords) on screen now?" && ${PAGER:-less} "$run/handover.txt"
			command -v lp >/dev/null && confirm "Send it to your default printer?" && lp "$run/handover.txt"
			say "Store it in your password manager, then: shred -u '$run/handover.txt'"
		fi
	else
		say "No handover yet. Continue later with: kyqs-ai resume"
	fi
	[ -f "$run/feedback.md" ] && say "Feedback report: $run/feedback.md"
	[ -f "$run/install-guide-draft.md" ] && say "Install guide draft: $run/install-guide-draft.md"
	say "When everything is done, remove the agent's server access: kyqs-ai revoke <name>"
}

pick_agent() {
	local found=() a i
	for a in "${AGENTS[@]}"; do command -v "$a" >/dev/null && found+=("$a"); done
	[ ${#found[@]} -gt 0 ] || die "no supported agent found; install one of: ${AGENTS[*]}"
	say "Which AI agent should do the install?" >&2
	for i in "${!found[@]}"; do say "  $((i + 1))) ${found[$i]}" >&2; done
	read -r -p "Choice [1]: " i
	i=${i:-1}
	[[ $i =~ ^[0-9]+$ ]] && [ "$i" -ge 1 ] && [ "$i" -le ${#found[@]} ] || die "no such choice"
	printf '%s' "${found[$((i - 1))]}"
}

pick_mode() {
	case $1 in
	claude | codex)
		say "Hands-off mode pre-approves ssh, git and the run's own helper scripts so the agent" >&2
		say "only stops when it truly needs you. It still asks before anything destructive." >&2
		if confirm "Use hands-off mode?"; then printf yes; else printf no; fi
		;;
	*) printf no ;;
	esac
}

start() {
	need git awk sed
	ssh_setup
	key_loaded
	say "Servers (the agent logs in as kyops: no sudo, no password, Docker access only):"
	hosts
	while confirm "Add a server now?"; do
		local n a p u
		read -r -p "  short name (e.g. core, nas): " n
		read -r -p "  address (hostname or IP): " a
		read -r -p "  ssh port [22]: " p
		read -r -p "  your admin login on it [$USER]: " u
		(add_host "$n" "$a" "${p:-22}" "${u:-$USER}") || say "  not added; fix the problem above and try again"
	done
	[ -n "$(host_aliases)" ] || die "no servers configured"

	local agent hands run
	agent=$(pick_agent)
	hands=$(pick_mode "$agent")
	umask 077
	run=$RUNS/$(date +%Y%m%d-%H%M%S)
	mkdir -p "$run/bin"
	cp "$ROOT/PROMPT.md" "$run/"
	cp "$ROOT/bin/progress" "$ROOT/bin/redact" "$ROOT/bin/handover" "$run/bin/"
	host_aliases >"$run/hosts.txt"
	printf 'agent: %s\nhands-off: %s\nlauncher: %s\nkyquickstart-ai: %s\n' "$agent" "$hands" "$ROOT/kyqs-ai" \
		"$(git -C "$ROOT" describe --always --dirty 2>/dev/null || echo unknown)" >"$run/launch.txt"
	say "Run folder: $run"
	dashboard_hint "$run"
	launch "$agent" "$hands" "$run" "You are running KyQuickStart AI. Read ./PROMPT.md in full and follow it exactly. Your run folder is the current directory. Servers are listed in ./hosts.txt."
	finish "$run"
}

resume() {
	local run agent hands
	run=$(latest_run)
	agent=$(sed -n 's/^agent: //p' "$run/launch.txt")
	hands=$(sed -n 's/^hands-off: //p' "$run/launch.txt")
	key_loaded
	dashboard_hint "$run"
	launch "$agent" "$hands" "$run" "You are resuming KyQuickStart AI. Read ./PROMPT.md in full, then ./state.md, ./progress.log and ./feedback.md, and continue from the first unfinished step. Do not redo finished steps."
	finish "$run"
}

revoke() {
	[ $# -ge 1 ] || die "usage: kyqs-ai revoke <name> [admin-user]"
	local alias=kyq-$1 admin=${2:-$USER}
	grep -qx "Host $alias" "$CONF" 2>/dev/null || die "unknown server $alias"
	remote_root "$alias" "$admin" "$ROOT/bin/revoke-host.sh"
	say "The pinned host entry stays in $CONF; delete its block there if the server is gone for good."
}

cmd=${1:-start}
[ $# -gt 0 ] && shift
case $cmd in
start) start ;;
add-host) add_host "$@" ;;
hosts) ssh_setup && hosts ;;
put-secret) put_secret "$@" ;;
dashboard) "$ROOT/bin/dashboard" "${1:-$(latest_run)}" ;;
resume) resume ;;
handover) "$ROOT/bin/handover" "${1:-$(latest_run)}" ;;
revoke) revoke "$@" ;;
-h | --help | help) usage ;;
*)
	usage >&2
	exit 2
	;;
esac
