#!/usr/bin/env bash
# KyQuickStart AI: connects your servers over SSH and your Kubernetes clusters, starts the local
# AI agent you choose with PROMPT.md and the kyquickstart execution layer, shows a live
# dashboard, and builds the handover sheet when the agent exits.
set -euo pipefail

ROOT=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
SSHD=$HOME/.ssh/kyquickstart-ai
CONF=$SSHD/config
KEY=$SSHD/id_ed25519
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/kyquickstart-ai
RUNS=$STATE/runs
LOCAL=$STATE/local-host # present when this computer is an install target
REVOKED=$STATE/revoked   # one empty file per kyq-<name> whose access was revoked
CLUSTERS=$STATE/clusters # one file per kube-<name>: the agent's ServiceAccount kubeconfig
KYQ_BIN=${KYQS_KYQUICKSTART-$(command -v kyquickstart || true)} # set but empty: none
DATA=${KYQS_DATA:-/srv/ky} # override for tests only; the prompt assumes /srv/ky
AGENTS=(claude codex gemini opencode)

say() { printf '%s\n' "$*"; }
die() {
	printf 'kyqs-ai: %s\n' "$*" >&2
	exit 1
}
confirm() {
	local r
	read -r -p "$1 [y/N] " r
	[[ $r == [yY]* ]]
}
need() { for c; do command -v "$c" >/dev/null || die "missing $c"; done; }
ssh_connect() { "$ROOT/bin/ssh-policy" "$@"; }

usage() {
	cat <<EOF
usage: kyqs-ai [command]

  start                          Guided start (default): servers, agent, run, handover
  add-local                      Install on this computer too (no SSH; the agent acts as you)
  add-host [--prepared] <name> <address> [port] [admin-user]
                                 Prepare a server and pin its host key as ssh alias kyq-<name>.
                                 --prepared: you already ran bin/prepare-host.sh at its console
  add-cluster <name> <admin-kubeconfig>
                                 Use a Kubernetes cluster as target kube-<name> (needs kyquickstart
                                 and kubectl): creates the agent's ServiceAccount with your kubeconfig
  remove-cluster <name>          Stop offering kube-<name>; the cluster and its apps are untouched
  hosts                          List install targets and check each one answers
  ssh-key                        Print the agent's public key as one base64 line, for running
                                 bin/prepare-host.sh at a server console yourself
  put-secret <target> <path>     Paste a secret straight onto local or kyq-<name> (hidden), e.g.
                                 a Cloudflare token the agent asked for. Path under /srv/ky/.
  dashboard [run-dir]            Live status board (latest run by default)
  resume                         Restart the agent on the latest run where it left off
  handover [run-dir]             Rebuild the printable handover sheet
  revoke <name> [admin-user]     Remove the agent's access to a server when you are done
                                 (revoke local: stop using this computer as a target)
  revoke kube-<name> <admin-kubeconfig>
                                 Delete the agent's ServiceAccount in that cluster
EOF
}

ssh_setup() {
	need ssh ssh-keygen ssh-keyscan base64
	umask 077
	mkdir -p "$SSHD"
	if [ ! -f "$KEY" ]; then
		say "Creating an SSH key used only by KyQuickStart AI: $KEY"
		say "A passphrase is recommended; the launcher loads it into ssh-agent for the session."
		ssh-keygen -q -t ed25519 -f "$KEY" -C "kyquickstart-ai@$(hostname)"
	fi
	[ -f "$CONF" ] || cat >"$CONF" <<EOF
# Managed by kyqs-ai. Each server is "ssh kyq-<name>" and logs in as the non-admin kyops user.
Host kyq-*
  User kyops
  IdentityFile $KEY
  IdentitiesOnly yes
  UserKnownHostsFile $SSHD/known_hosts
  StrictHostKeyChecking yes
  BatchMode yes
  ServerAliveInterval 30
EOF
	local main=$HOME/.ssh/config line="Include $CONF"
	if ! grep -qxF "$line" "$main" 2>/dev/null; then
		[ -L "$main" ] && die "$main is a symlink; add this as its first line yourself, then re-run: $line"
		say "So 'ssh kyq-<name>' works for you and the agent, ~/.ssh/config needs this first line:"
		say "  $line"
		confirm "Add it now?" || die "add the line yourself, then re-run"
		{
			printf '%s\n\n' "$line"
			cat "$main" 2>/dev/null || true
		} >"$main.kyqs-ai.tmp"
		mv "$main.kyqs-ai.tmp" "$main"
	fi
}

key_loaded() {
	ssh-keygen -y -P '' -f "$KEY" >/dev/null 2>&1 && return # no passphrase
	local fp
	fp=$(ssh-keygen -lf "$KEY.pub" | awk '{print $2}')
	ssh-add -l 2>/dev/null | grep -qF "$fp" && return
	[ -n "${SSH_AUTH_SOCK:-}" ] || die "the key has a passphrase but no ssh-agent is running; start one (eval \$(ssh-agent)) and re-run"
	say "Loading the KyQuickStart AI key into ssh-agent for 12 hours."
	ssh-add -t 12h "$KEY"
}

host_aliases() { [ -f "$CONF" ] && awk '$1 == "Host" && $2 != "kyq-*" {print $2}' "$CONF"; }
cluster_names() { [ -d "$CLUSTERS" ] && ls "$CLUSTERS"; }
targets() { # every install target, one per line: local first, then ssh aliases, then clusters
	[ -f "$LOCAL" ] && echo local
	host_aliases || true
	cluster_names || true
}
# shellcheck disable=SC2012 # callers pass validated paths; ls -lL is the portable mode read (BSD and GNU)
private_file() { [ -f "$1" ] && [ "$(ls -lL "$1" | cut -c5-10)" = ------ ]; } # no group/other access

docker_problem() { # why this computer's Docker is unusable for us, or nothing
	local me
	me=$(id -un)
	if ! command -v docker >/dev/null; then
		if command -v podman >/dev/null; then
			echo "only Podman is installed; the suite needs Docker Engine and its compose plugin"
		else
			echo "Docker is not installed; install Docker Engine and its compose plugin first"
		fi
	elif ! docker info >/dev/null 2>&1; then
		if id -nG "$me" | tr ' ' '\n' | grep -qx docker && ! id -nG | tr ' ' '\n' | grep -qx docker; then
			echo "you are in the docker group, but this login session started before that; log out and back in (or reboot), then run kyqs-ai again"
		elif getent group docker >/dev/null && ! id -nG "$me" | tr ' ' '\n' | grep -qx docker; then
			echo "you cannot use Docker; add yourself to the docker group (sudo usermod -aG docker $me, root-equivalent), then log out and back in"
		else
			echo "the Docker daemon is not answering; start it (e.g. sudo systemctl enable --now docker)"
		fi
	elif ! docker compose version >/dev/null 2>&1; then
		echo "the docker compose plugin is missing"
	fi
}

target_problem() { # <target>: why the agent cannot use it, or nothing
	if [ "$1" = local ]; then
		docker_problem
		[ -w "$DATA" ] || echo "$DATA is missing or not writable by you; run kyqs-ai add-local"
	elif [[ $1 == kube-* ]]; then
		if [ -f "$REVOKED/$1" ]; then
			echo "access revoked with kyqs-ai revoke; restore it with kyqs-ai add-cluster ${1#kube-} <admin-kubeconfig>"
		elif [ -z "$KYQ_BIN" ]; then
			echo "Kubernetes targets need the kyquickstart binary: put it on PATH or set KYQS_KYQUICKSTART"
		elif ! grep -q '^kind: Config' "$CLUSTERS/$1"; then
			echo "added by an older kyqs-ai with your own kubeconfig; re-run kyqs-ai add-cluster ${1#kube-} <admin-kubeconfig>"
		elif ! private_file "$CLUSTERS/$1"; then
			echo "$CLUSTERS/$1 is readable by other users (chmod 600 it)"
		fi
	elif [ -f "$REVOKED/$1" ]; then
		echo "access revoked with kyqs-ai revoke; restore it with kyqs-ai add-host ${1#kyq-} $(ssh_connect -G "$1" | awk '$1 == "hostname" {print $2}')"
	elif ! ssh-keygen -F "$1" -f "$SSHD/known_hosts" >/dev/null 2>&1; then
		echo "host key not pinned; finish setup with kyqs-ai add-host ${1#kyq-} <address>"
	elif ! ssh_connect -o ConnectTimeout=8 "$1" true </dev/null 2>/dev/null; then
		echo "kyops cannot log in (server down, key not loaded in ssh-agent, or access revoked at the server?)"
	elif ! ssh_connect "$1" 'docker info >/dev/null 2>&1' </dev/null; then
		echo "kyops cannot use Docker there"
	elif ! ssh_connect "$1" 'test -w /srv/ky' </dev/null; then
		echo "/srv/ky is missing or not writable by kyops; re-run kyqs-ai add-host for it"
	fi
}

is_this_computer() { # <address>
	case $1 in localhost | localhost.* | 127.* | ::1 | 0.0.0.0) return 0 ;; esac
	[ "$1" = "$(hostname)" ] && return 0
	local ips
	ips=$( (hostname -I 2>/dev/null || ifconfig 2>/dev/null | awk '$1 == "inet" || $1 == "inet6" {print $2}') | tr '\n' ' ')
	[[ " $ips " == *" $1 "* ]]
}

add_local() {
	local why
	why=$(docker_problem)
	[ -z "$why" ] || die "$why"
	if [ ! -d "$DATA" ]; then
		say "Apps are installed under $DATA, owned by you. Creating it needs sudo once:"
		say "  sudo install -d -m 750 -o $(id -un) -g $(id -gn) $DATA"
		confirm "Run that now?" || die "create $DATA yourself, then re-run"
		sudo install -d -m 750 -o "$(id -un)" -g "$(id -gn)" "$DATA"
	fi
	[ -w "$DATA" ] || die "$DATA exists but you cannot write to it; fix its owner yourself (nothing was changed)"
	mkdir -p "$STATE"
	: >"$LOCAL"
	say "ready: local (this computer). The agent runs commands here as $(id -un), with your rights;"
	say "use supervised mode if you want to approve each one."
}

remote_root() { # <address> <port> <admin> <script> [args]: run a bundled script as root over the admin's own SSH
	local addr=$1 port=$2 admin=$3 s
	s=$(base64 <"$4" | tr -d '\n')
	shift 4
	# Everything is base64, so the admin's login shell (bash, fish, ...) cannot reinterpret it.
	ssh_connect -t -p "$port" "$admin@$addr" "sudo sh -c 'echo $s | base64 -d | sh -s -- $*'"
}

add_host() {
	local prepared=
	[ "${1:-}" = --prepared ] && prepared=1 && shift
	[ $# -ge 2 ] || die "usage: kyqs-ai add-host [--prepared] <name> <address> [port] [admin-user]"
	local name=$1 addr=$2 port=${3:-22} admin=${4:-$USER}
	local alias=kyq-$name
	[[ $name =~ ^[a-z0-9][a-z0-9-]{0,30}$ ]] || die "name: lowercase letters, digits and dashes"
	[[ $name != kube-* ]] || die "name: kube- names Kubernetes targets; choose another"
	[[ $addr =~ ^[A-Za-z0-9.:-]+$ ]] || die "address: hostname or IP"
	[[ $port =~ ^[0-9]{1,5}$ ]] || die "port: a number"
	[[ $admin =~ ^[A-Za-z0-9._-]+$ ]] || die "admin-user: a login name"
	is_this_computer "$addr" && die "$addr is this computer. Install here with: kyqs-ai add-local (no SSH needed)"
	ssh_setup
	key_loaded
	if grep -qx "Host $alias" "$CONF"; then
		[ "$(ssh_connect -G "$alias" | awk '$1 == "hostname" {print $2}')" = "$addr" ] || die "$alias already points elsewhere; edit $CONF"
	fi

	local out='' k
	if [ -n "$prepared" ]; then
		say "1/3  Skipped: kyops was prepared at the server console."
	else
		say "1/3  Creating the non-admin 'kyops' login on $addr, as $admin (sudo will ask for your password)."
		k=$(base64 <"$KEY.pub" | tr -d '\n')
		out=$(remote_root "$addr" "$port" "$admin" "$ROOT/bin/prepare-host.sh" "$k" | tee /dev/stderr | tr -d '\r') ||
			die "preparing $addr failed (output above). Fix it and re-run the same command; it is safe to repeat."
	fi

	say "2/3  Pinning the server's SSH host key."
	local want scan tmp got
	want=$(sed -n 's/^KYQ-HOSTKEY //p' <<<"$out")
	scan=$(ssh-keyscan -T 10 -t ed25519 -p "$port" "$addr" 2>/dev/null | grep -v '^#' || true)
	[ -n "$scan" ] || die "no ed25519 host key answered on $addr:$port"
	tmp=$(mktemp)
	awk -v a="$alias" '{print a, $2, $3}' <<<"$scan" >"$tmp"
	got=$(ssh-keygen -lf "$tmp" | awk '{print $2}')
	if [ -z "$want" ]; then
		say "The server did not report its key. Compare by hand on its console:"
		say "  ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub   should show   $got"
		confirm "Does it match?" || {
			rm -f "$tmp"
			die "host key not confirmed; nothing pinned"
		}
	elif [ "$want" != "$got" ]; then
		rm -f "$tmp"
		die "HOST KEY MISMATCH: server says $want, network answered $got. Possible interception; nothing pinned."
	fi
	if ssh-keygen -F "$alias" -f "$SSHD/known_hosts" >/dev/null 2>&1; then
		ssh-keygen -F "$alias" -f "$SSHD/known_hosts" | grep -qF "$(awk '{print $3}' "$tmp")" ||
			{
				rm -f "$tmp"
				die "$alias is pinned to a DIFFERENT key. A changed host key is never accepted; investigate first."
			}
	else
		cat "$tmp" >>"$SSHD/known_hosts"
	fi
	rm -f "$tmp"
	say "     pinned $got"
	# Only now does the server become a target: a half-finished setup leaves no alias behind.
	grep -qx "Host $alias" "$CONF" ||
		printf '\nHost %s\n  HostName %s\n  Port %s\n  HostKeyAlias %s\n' "$alias" "$addr" "$port" "$alias" >>"$CONF"

	say "3/3  Testing the agent's login."
	# shellcheck disable=SC2016 # substitutions run on the server
	ssh_connect "$alias" 'printf "%s, docker %s\n" "$(id -un)" "$(docker version --format "{{.Server.Version}}")"' </dev/null ||
		die "kyops cannot log in or reach Docker on $addr"
	rm -f "$REVOKED/$alias"
	say "ready: ssh $alias"
}

# The agent's ServiceAccount: what kyquickstart preflight checks (KyQuickStart
# internal/kube/preflight.go, `required`), plus get pods/log for `logs`. Leases are cluster-wide
# because kyquickstart creates its lock namespace on the first apply.
KUBE_NS=kyqs-ai
kube_grant() { # <name>
	cat <<EOF
apiVersion: v1
kind: Namespace
metadata: {name: $KUBE_NS}
---
apiVersion: v1
kind: ServiceAccount
metadata: {name: $1, namespace: $KUBE_NS}
automountServiceAccountToken: false
---
apiVersion: v1
kind: Secret
type: kubernetes.io/service-account-token
metadata:
  name: $1
  namespace: $KUBE_NS
  annotations: {kubernetes.io/service-account.name: $1}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata: {name: $1}
rules:
- {apiGroups: [""], resources: [namespaces], verbs: [get, create, update, patch]}
- {apiGroups: [""], resources: [pods], verbs: [get, list, create, delete]}
- {apiGroups: [""], resources: [pods/exec, pods/portforward], verbs: [create]}
- {apiGroups: [""], resources: [pods/log], verbs: [get]}
- {apiGroups: [""], resources: [secrets], verbs: [get, create, update, patch]}
- {apiGroups: [""], resources: [services], verbs: [get, list, create, update, patch, delete]}
- {apiGroups: [""], resources: [persistentvolumeclaims], verbs: [get, create, patch]}
- {apiGroups: [apps], resources: [deployments], verbs: [get, create, update, patch, delete]}
- {apiGroups: [networking.k8s.io], resources: [networkpolicies], verbs: [get, create, update, patch]}
- {apiGroups: [storage.k8s.io], resources: [storageclasses], verbs: [list]}
- {apiGroups: [coordination.k8s.io], resources: [leases], verbs: [get, create, delete]}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata: {name: $1}
roleRef: {apiGroup: rbac.authorization.k8s.io, kind: ClusterRole, name: $1}
subjects: [{kind: ServiceAccount, name: $1, namespace: $KUBE_NS}]
EOF
}

add_cluster() {
	[ $# = 2 ] || die "usage: kyqs-ai add-cluster <name> <admin-kubeconfig>"
	[[ $1 =~ ^[a-z][a-z0-9-]{0,25}$ ]] || die "name: a lowercase letter, then letters, digits and dashes"
	[ -n "$KYQ_BIN" ] || die "Kubernetes targets need the kyquickstart binary: put it on PATH or set KYQS_KYQUICKSTART"
	need kubectl base64
	private_file "$2" || die "$2 is not a file only you can read; chmod 600 it first"
	local sa=kyqs-ai-$1 kc=$CLUSTERS/kube-$1 admin=$2 token='' ca server sni
	[[ $kc =~ ^/[A-Za-z0-9._/-]+$ ]] || die "state path $kc: letters, digits and . _ / - only"
	k() { kubectl --kubeconfig "$admin" "$@"; }
	field() { k config view --minify --raw --flatten -o "jsonpath={.clusters[0].cluster.$1}"; }
	[ "$(field insecure-skip-tls-verify)" != true ] || die "$admin skips TLS verification; the agent's kubeconfig would too"
	server=$(field server)
	ca=$(field certificate-authority-data)
	sni=$(field tls-server-name)
	say "Creating ServiceAccount $KUBE_NS/$sa with the permissions kyquickstart checks (README)."
	kube_grant "$sa" | k apply -f - >/dev/null || die "creating it failed (above). Fix it and re-run; it is safe to repeat."
	for _ in $(seq 30); do
		token=$(k -n "$KUBE_NS" get secret "$sa" -o 'jsonpath={.data.token}' 2>/dev/null) || true
		[ -z "$token" ] || break
		sleep 1
	done
	[ -n "$token" ] || die "the cluster issued no token for $sa; is its token controller running? Re-run when it is."
	# Each value lands in YAML unquoted: anything beyond its plain shape could add keys, such
	# as an exec credential plugin from a Secret someone in the cluster rewrote.
	token=$(base64 -d <<<"$token" 2>/dev/null) || token=''
	[[ $token =~ ^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$ ]] || die "the token in Secret $KUBE_NS/$sa is not a JWT; delete that Secret and re-run"
	[[ $server =~ ^https://[][A-Za-z0-9.:-]+(/[A-Za-z0-9._/-]*)?$ ]] || die "$admin's server $server is not a plain https URL"
	[[ $ca =~ ^[A-Za-z0-9+/=]*$ ]] || die "$admin's certificate-authority-data is not base64"
	[[ $sni =~ ^[A-Za-z0-9.-]*$ ]] || die "$admin's tls-server-name is not a hostname"
	umask 077
	mkdir -p "$CLUSTERS"
	{
		printf 'apiVersion: v1\nkind: Config\nclusters:\n- name: kube-%s\n  cluster:\n    server: %s\n' "$1" "$server"
		[ -z "$ca" ] || printf '    certificate-authority-data: %s\n' "$ca"
		[ -z "$sni" ] || printf '    tls-server-name: %s\n' "$sni"
		printf 'users:\n- name: %s\n  user:\n    token: %s\n' "$sa" "$token"
		printf 'contexts:\n- name: kube-%s\n  context: {cluster: kube-%s, user: %s}\ncurrent-context: kube-%s\n' "$1" "$1" "$sa" "$1"
	} >"$kc.tmp"
	kubectl --kubeconfig "$kc.tmp" auth can-i create deployments.apps -A >/dev/null 2>&1 || {
		rm -f "$kc.tmp"
		die "the new ServiceAccount kubeconfig cannot reach $server; nothing registered"
	}
	# Only now does the cluster become a target: a half-finished setup leaves none behind.
	mv "$kc.tmp" "$kc"
	rm -f "$REVOKED/kube-$1"
	say "ready: kube-$1. kyquickstart uses $kc (ServiceAccount $sa, not cluster-admin, but able to"
	say "create pods and read Secrets in every namespace: README). Remove it with kyqs-ai revoke kube-$1 <admin-kubeconfig>."
}

remove_cluster() {
	if [ $# != 1 ] || [ ! -f "$CLUSTERS/kube-$1" ]; then die "usage: kyqs-ai remove-cluster <name> (an added cluster)"; fi
	[ -f "$REVOKED/kube-$1" ] || say "Its ServiceAccount still works; delete it with: kyqs-ai revoke kube-$1 <admin-kubeconfig>"
	rm -f "$CLUSTERS/kube-$1" "$REVOKED/kube-$1"
	say "kube-$1 is no longer a target. The cluster and its apps are untouched."
}

revoke_cluster() { # <kube-name> <admin-kubeconfig>
	[ $# = 2 ] || die "usage: kyqs-ai revoke kube-<name> <admin-kubeconfig>"
	[[ $1 =~ ^kube-[a-z][a-z0-9-]{0,25}$ ]] || die "unknown cluster $1"
	need kubectl
	local sa=kyqs-ai-${1#kube-}
	# The binding first, so a revoke that dies halfway has already removed the rights.
	if ! kubectl --kubeconfig "$2" delete --ignore-not-found "clusterrolebinding/$sa" "clusterrole/$sa" >/dev/null ||
		! kubectl --kubeconfig "$2" -n "$KUBE_NS" delete --ignore-not-found "secret/$sa" "serviceaccount/$sa" >/dev/null; then
		die "revoking failed (above). Fix it and re-run; it is safe to repeat."
	fi
	mkdir -p "$REVOKED"
	: >"$REVOKED/$1"
	[ ! -f "$CLUSTERS/$1" ] || : >"$CLUSTERS/$1" # keep the target listed, without the dead token
	say "revoked: ServiceAccount $KUBE_NS/$sa and its token are gone. Apps are untouched."
	say "To give the agent access again: kyqs-ai add-cluster ${1#kube-} <admin-kubeconfig>"
}

# One line per ready target for the agent's kyquickstart plan: no secrets, only where and how.
target_facts() {
	local t
	printf 'target\tkind\taddress\tport\tuser\thost_key\tkubeconfig\n'
	for t; do
		case $t in
		local) printf 'local\tlocal\t-\t-\t-\t-\t-\n' ;;
		kube-*) printf '%s\tkubernetes\t-\t-\t-\t-\t%s\n' "$t" "$CLUSTERS/$t" ;;
		*) printf '%s\tssh\t%s\t%s\tkyops\t%s\t-\n' "$t" "$(ssh_connect -G "$t" | awk '$1 == "hostname" {print $2}')" \
			"$(ssh_connect -G "$t" | awk '$1 == "port" {print $2}')" \
			"$(ssh-keygen -lF "$t" -f "$SSHD/known_hosts" | awk '!/^#/ {print $3; exit}')" ;;
		esac
	done
}

hosts() {
	local a any='' why
	for a in $(targets); do
		any=1
		why=$(target_problem "$a")
		if [ -n "$why" ]; then say "  ✖ $a: $why"; elif [ "$a" = local ]; then say "  ✔ local (this computer)"; else say "  ✔ $a"; fi
	done
	[ -n "$any" ] || say "  none yet: kyqs-ai add-local, kyqs-ai add-host <name> <address> [port] [admin-user], or kyqs-ai add-cluster <name> <kubeconfig>"
	[ -n "$KYQ_BIN" ] || say "  kyquickstart not found: only README installs on Docker; set KYQS_KYQUICKSTART or put it on PATH"
}

# shellcheck disable=SC2029 # the path is validated, then expanded locally on purpose
put_secret() {
	[ $# = 2 ] || die "usage: kyqs-ai put-secret <local|kyq-name> </srv/ky/... path>"
	[[ $1 == local || $1 =~ ^kyq-[a-z0-9-]+$ ]] || die "target must be local or kyq-<name>"
	local root=/srv/ky
	[ "$1" = local ] && root=$DATA
	[[ $2 == "$root"/* && $2 =~ ^/[A-Za-z0-9._/-]+$ && $2 != *..* ]] || die "path must be under $root/"
	local v
	if [ -t 0 ]; then
		read -r -s -p "Paste the secret (hidden), then Enter: " v
		echo
	else
		v=$(cat)
	fi
	# A pasted blank line or trailing newline would become part of the token.
	v=${v#"${v%%[![:space:]]*}"}
	v=${v%"${v##*[![:space:]]}"}
	[ -n "$v" ] || die "empty secret; nothing stored"
	printf '%s' "$v" | "$ROOT/bin/on" "$1" "umask 077 && mkdir -p \"\$(dirname '$2')\" && cat > '$2'"
	say "stored on $1 at $2 (mode 0600). The agent can now use it without seeing it."
}

latest_run() {
	local runs=("$RUNS"/*/) last
	last=${runs[${#runs[@]} - 1]} # bash 3.2 (macOS) has no negative indexes
	[ -d "$last" ] || die "no runs yet; start one with: kyqs-ai"
	printf '%s' "${last%/}"
}

# kyquickstart signs in only through ssh-agent and offers every key an agent holds. The run
# gets its own agent with the KyQuickStart AI key alone: the user's other keys neither reach
# the run nor use up a server's MaxAuthTries.
run_agent() { # <run>
	if [ -z "$KYQ_BIN" ] || ! grep -q '^kyq-' "$1/hosts.txt"; then return; fi
	# A short private socket path: Unix sockets cap paths near 104 bytes, and ~/.ssh/agent/ can exceed it.
	KYQS_AGENT_DIR=$(mktemp -d /tmp/kyqs-agent.XXXXXX)
	eval "$(ssh-agent -s -a "$KYQS_AGENT_DIR/s")" >/dev/null
	trap 'kill "$SSH_AGENT_PID" 2>/dev/null; rm -rf "$KYQS_AGENT_DIR"' EXIT
	ssh-add -q -t 12h "$KEY" || say "kyquickstart cannot reach the servers: the key was not added to the run's ssh-agent"
}

launch() { # <agent> <hands-off:yes|no> <run> <kickoff>
	local agent=$1 hands=$2 run=$3 kick=$4 t deny=''
	run_agent "$run"
	case $agent in
	claude)
		if [ "$hands" = yes ]; then
			# Kubeconfig paths are validated to [A-Za-z0-9._/-], so they need no JSON escaping.
			for t in $(grep '^kube-' "$run/hosts.txt" || true); do
				deny="$deny${deny:+, }\"Read(/$CLUSTERS/$t)\""
			done
			mkdir -p "$run/.claude"
			cat >"$run/.claude/settings.json" <<EOF
{
  "permissions": {
    "allow": [
      "Bash(ssh:*)", "Bash(scp:*)", "Bash(git clone:*)", "Bash(git -C:*)", "Bash(git ls-remote:*)",
      "Bash(curl:*)", "Bash(dig:*)", "Bash(getent:*)",
      "Bash(./bin/on:*)", "Bash(./bin/progress:*)", "Bash(./bin/redact:*)", "Bash(./bin/handover:*)",
      "Bash(./bin/kyquickstart:*)",
      "Read", "Edit", "Write"
    ],
    "deny": [$deny]
  }
}
EOF
		fi
		(cd "$run" && claude "$kick")
		;;
	codex)
		local approval=on-request extra=()
		[ "$hands" = yes ] && approval=never
		grep -qx local "$run/hosts.txt" && extra=(--add-dir "$DATA")
		(cd "$run" && codex -C "$run" -s workspace-write -c sandbox_workspace_write.network_access=true \
			${extra[@]+"${extra[@]}"} -a "$approval" "$kick")
		;;
	gemini) (cd "$run" && gemini -i "$kick") ;;
	opencode) (cd "$run" && opencode --prompt "$kick") ;;
	esac
}

dashboard_hint() {
	if [ -n "${TMUX:-}" ]; then
		tmux split-window -h -d -l 45% "'$ROOT/bin/dashboard' '$1'"
		say "Dashboard opened in the right-hand tmux pane."
	else
		say "Live dashboard: open a second terminal and run"
		say "  $ROOT/kyqs-ai dashboard"
		say "(Install tmux and it opens beside the agent by itself.)"
		# The agent's full-screen view would cover this at once.
		[ ! -t 0 ] || read -rp "Press Enter to start the agent. " _
	fi
}

finish() {
	local run=$1
	say ""
	say "── agent session ended ──"
	if [ -f "$run/handover.tsv" ]; then
		"$ROOT/bin/handover" "$run" || true
		if [ -f "$run/handover.txt" ]; then
			confirm "Show the handover sheet (passwords) on screen now?" && ${PAGER:-less} "$run/handover.txt"
			command -v lp >/dev/null && confirm "Send it to your default printer?" && lp "$run/handover.txt"
			say "Store it in your password manager, then: shred -u '$run/handover.txt'"
		fi
	else
		say "No handover yet. Continue later with: kyqs-ai resume"
	fi
	[ -f "$run/feedback.md" ] && say "Feedback report: $run/feedback.md"
	[ -f "$run/install-guide-draft.md" ] && say "Install guide draft: $run/install-guide-draft.md"
	say "When everything is done, remove the agent's access: kyqs-ai revoke <name> (a cluster: revoke kube-<name> <admin-kubeconfig>)"
}

pick_agent() {
	local found=() a i
	for a in "${AGENTS[@]}"; do command -v "$a" >/dev/null && found+=("$a"); done
	[ ${#found[@]} -gt 0 ] || die "no supported agent found; install one of: ${AGENTS[*]}"
	say "Which AI agent should do the install?" >&2
	for i in "${!found[@]}"; do say "  $((i + 1))) ${found[$i]}" >&2; done
	read -r -p "Choice [1]: " i
	i=${i:-1}
	if ! [[ $i =~ ^[0-9]+$ ]] || [ "$i" -lt 1 ] || [ "$i" -gt ${#found[@]} ]; then die "no such choice"; fi
	printf '%s' "${found[$((i - 1))]}"
}

pick_mode() {
	case $1 in
	claude | codex)
		if [ "$1" = claude ]; then
			say "Hands-off mode pre-approves, for any host and any arguments: ssh, scp, curl, dig," >&2
			say "getent, git clone/-C/ls-remote and the run's helper scripts (./bin/on runs any command" >&2
			say "on a target), plus reading, editing and writing any file on this computer." >&2
		else
			say "Hands-off mode runs Codex with -a never: every command runs without asking, inside its" >&2
			say "sandbox (writes only in the run folder, and $DATA if this computer is a target; network on)." >&2
		fi
		say "The prompt tells the agent to ask before anything destructive; nothing enforces that." >&2
		say "Details: README.md, \"Hands-off mode\". Otherwise it asks before each command." >&2
		if confirm "Use hands-off mode?"; then printf yes; else printf no; fi
		;;
	*) printf no ;;
	esac
}

# self_update <command>: offers to fast-forward this checkout when its upstream moved on, then
# reruns the command with the new launcher. Local changes or a diverged branch are only reported.
self_update() {
	local up behind
	up=$(git -C "$ROOT" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null) || return 0
	git -C "$ROOT" fetch -q 2>/dev/null || {
		say "Could not check for a newer KyQuickStart AI (offline?); continuing with this one."
		return 0
	}
	behind=$(git -C "$ROOT" rev-list --count "HEAD..$up")
	[ "$behind" -gt 0 ] || return 0
	say "KyQuickStart AI is $behind commit(s) behind $up."
	if [ -n "$(git -C "$ROOT" status --porcelain --untracked-files=no)" ] || ! git -C "$ROOT" merge-base --is-ancestor HEAD "$up"; then
		say "  This copy has local changes, so update it yourself: git -C $ROOT pull --ff-only"
		return 0
	fi
	confirm "Update it now?" || return 0
	git -C "$ROOT" merge -q --ff-only "$up"
	say "Updated. Restarting with the new version."
	exec "$ROOT/kyqs-ai" "$1"
}

KYQ_REPO=Busnes-app/KyQuickStart

# latest_release: the newest KyQuickStart release as lines "tag <tag>" and
# "asset <name> <url> <sha256:digest>". Needs gh, or curl and jq; prints nothing without them.
latest_release() {
	local q='"tag \(.tag_name)", (.assets[] | "asset \(.name) \(.browser_download_url) \(.digest)")'
	if command -v gh >/dev/null; then
		gh api "repos/$KYQ_REPO/releases/latest" --jq "$q" 2>/dev/null
	elif command -v curl >/dev/null && command -v jq >/dev/null; then
		curl -fsSL --max-time 15 "https://api.github.com/repos/$KYQ_REPO/releases/latest" 2>/dev/null | jq -r "$q"
	fi
}

older() { # <a> <b>: version a is older than b (X.Y.Z)
	[ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -t. -k1,1n -k2,2n -k3,3n | head -1)" = "$1" ]
}

# kyq_update: offers the latest kyquickstart release when the one in use is older or missing.
# The download must match the digest GitHub publishes for it and, when gh is installed, the
# release's build attestation; it then replaces the old binary (or goes to ~/.local/bin).
kyq_update() {
	local rel tag have os arch name url digest dest tmp sum
	[ -n "$KYQ_BIN" ] || [ -z "${KYQS_KYQUICKSTART+set}" ] || return 0 # set empty on purpose: none
	rel=$(latest_release) || true
	tag=$(printf '%s\n' "$rel" | sed -n 's/^tag v//p')
	if [ -z "$tag" ]; then
		say "Could not check for a newer kyquickstart (offline, or neither gh nor curl and jq)."
		return 0
	fi
	have=
	[ -z "$KYQ_BIN" ] || have=$("$KYQ_BIN" version 2>/dev/null | head -1)
	case $have in
	dev)
		say "kyquickstart here is a development build; the latest release is v$tag."
		return 0
		;;
	'') ;;
	*) older "$have" "$tag" || return 0 ;;
	esac
	os=$(uname -s | tr '[:upper:]' '[:lower:]')
	case $(uname -m) in x86_64 | amd64) arch=amd64 ;; aarch64 | arm64) arch=arm64 ;; *) arch=$(uname -m) ;; esac
	name=kyquickstart-$tag-$os-$arch
	read -r url digest <<<"$(printf '%s\n' "$rel" | awk -v n="$name" '$1 == "asset" && $2 == n {print $3, $4}')"
	if [ -z "$url" ] || [ "${digest#sha256:}" = "$digest" ]; then
		say "kyquickstart v$tag is out, but the release has no verified $name binary yet."
		return 0
	fi
	dest=${KYQ_BIN:-$HOME/.local/bin/kyquickstart}
	[ -w "$(dirname "$dest")" ] || dest=$HOME/.local/bin/kyquickstart # a system copy stays as it is
	if [ -n "$have" ]; then
		confirm "kyquickstart $have is older than the latest release, v$tag. Download v$tag to $dest?" || return 0
	else
		confirm "kyquickstart is not installed. Download the latest release, v$tag, to $dest?" || return 0
	fi
	mkdir -p "$(dirname "$dest")"
	tmp=$(mktemp "$(dirname "$dest")/.kyquickstart.XXXXXX")
	if ! curl -fsSL --max-time 300 -o "$tmp" "$url"; then
		rm -f "$tmp"
		say "  download failed; keeping ${have:+kyquickstart }${have:-nothing}"
		return 0
	fi
	sum=$( (sha256sum "$tmp" 2>/dev/null || shasum -a 256 "$tmp") | awk '{print $1}')
	if [ "sha256:$sum" != "$digest" ]; then
		rm -f "$tmp"
		say "  the download does not match the digest GitHub published; not installed"
		return 0
	fi
	if command -v gh >/dev/null && ! gh attestation verify "$tmp" --repo "$KYQ_REPO" >/dev/null 2>&1; then
		rm -f "$tmp"
		say "  its build attestation did not verify; not installed"
		return 0
	fi
	chmod 755 "$tmp"
	mv -f "$tmp" "$dest"
	KYQ_BIN=$dest
	say "  kyquickstart v$tag installed at $dest"
}

start() {
	need git awk sed
	[ ! -t 0 ] || kyq_update
	say "Install targets:"
	hosts
	if [ ! -f "$LOCAL" ] && confirm "Install on this computer?"; then
		(add_local) || say "  this computer not added; fix the problem above and try again"
	fi
	say "Remote servers are reached over SSH as kyops: no sudo, no password, but in the docker group,"
	say "which is root-equivalent on that server. Remove it when done with kyqs-ai revoke <name>."
	say "Kubernetes clusters are added with kyqs-ai add-cluster <name> <admin-kubeconfig> before the start."
	while confirm "Add a remote server?"; do
		local n a p u
		read -r -p "  short name (e.g. core, nas): " n
		read -r -p "  address (hostname or IP): " a
		read -r -p "  ssh port [22]: " p
		read -r -p "  your admin login on it [$USER]: " u
		(add_host "$n" "$a" "${p:-22}" "${u:-$USER}") || say "  not added; fix the problem above and try again"
	done
	[ -n "$(targets)" ] || die "no install targets: add this computer or a server"
	[ -z "$(host_aliases)" ] || key_loaded
	local t ready=() why
	for t in $(targets); do
		why=$(target_problem "$t")
		if [ -z "$why" ]; then ready+=("$t"); else say "  ✖ $t: $why"; fi
	done
	[ ${#ready[@]} -gt 0 ] || die "no install target is ready; fix the problems above and run kyqs-ai again"
	if [ ${#ready[@]} -lt "$(targets | wc -l)" ]; then
		confirm "Start with only the ready targets (${ready[*]})?" || die "fix the problems above and run kyqs-ai again"
	fi

	local agent hands run
	agent=$(pick_agent)
	hands=$(pick_mode "$agent")
	umask 077
	run=$RUNS/$(date +%Y%m%d-%H%M%S)
	mkdir -p "$run/bin"
	cp "$ROOT/PROMPT.md" "$run/"
	cp "$ROOT/bin/on" "$ROOT/bin/progress" "$ROOT/bin/redact" "$ROOT/bin/handover" "$ROOT/bin/ssh-policy" "$run/bin/"
	# The run keeps its own copy, so a resume uses the same execution layer.
	[ -z "$KYQ_BIN" ] || cp "$KYQ_BIN" "$run/bin/kyquickstart"
	mkdir -p "$run/kyq"
	printf '%s\n' "${ready[@]}" >"$run/hosts.txt"
	target_facts "${ready[@]}" >"$run/targets.tsv"
	printf 'agent: %s\nhands-off: %s\nlauncher: %s\nkyquickstart-ai: %s\nkyquickstart: %s\n' "$agent" "$hands" "$ROOT/kyqs-ai" \
		"$(git -C "$ROOT" describe --tags --always --dirty 2>/dev/null || echo unknown)" \
		"$([ -x "$run/bin/kyquickstart" ] && "$run/bin/kyquickstart" version | head -1 || echo none)" >"$run/launch.txt"
	say "Run folder: $run"
	local kick="You are running KyQuickStart AI. Read ./PROMPT.md in full and follow it exactly. Your run folder is the current directory. Install targets are listed in ./hosts.txt."
	# The interview as a form here, with lists to tick, instead of a chat message to edit.
	if [ -t 0 ]; then
		"$ROOT/bin/interview" "$run" || die "setup cancelled before the agent started; nothing was installed"
		kick="$kick The user answered the interview in ./interview.yaml."
	fi
	dashboard_hint "$run"
	launch "$agent" "$hands" "$run" "$kick"
	finish "$run"
}

resume() {
	local run agent hands
	run=$(latest_run)
	agent=$(sed -n 's/^agent: //p' "$run/launch.txt")
	hands=$(sed -n 's/^hands-off: //p' "$run/launch.txt")
	grep -q '^kyq-' "$run/hosts.txt" && key_loaded
	dashboard_hint "$run"
	launch "$agent" "$hands" "$run" "You are resuming KyQuickStart AI. Read ./PROMPT.md in full, then ./state.md, ./progress.log and ./feedback.md, and continue from the first unfinished step. Do not redo finished steps."
	finish "$run"
}

revoke() {
	[ $# -ge 1 ] || die "usage: kyqs-ai revoke <name> [admin-user]"
	[[ $1 != kube-* ]] || {
		revoke_cluster "$@"
		return
	}
	if [ "$1" = local ]; then
		rm -f "$LOCAL"
		say "This computer is no longer an install target. Apps and $DATA are untouched; nothing else to revoke,"
		say "since the agent used your own account here."
		return
	fi
	local alias=kyq-$1 admin=${2:-$USER}
	grep -qx "Host $alias" "$CONF" 2>/dev/null || die "unknown server $alias"
	remote_root "$(ssh_connect -G "$alias" | awk '$1 == "hostname" {print $2}')" "$(ssh_connect -G "$alias" | awk '$1 == "port" {print $2}')" \
		"$admin" "$ROOT/bin/revoke-host.sh"
	mkdir -p "$REVOKED"
	: >"$REVOKED/$alias"
	say "The pinned host entry stays in $CONF; delete its block there if the server is gone for good."
	say "To give the agent access again: kyqs-ai add-host $1 <address>"
}

cmd=${1:-start}
[ $# -gt 0 ] && shift
case $cmd in start | resume) [ ! -t 0 ] || self_update "$cmd" ;; esac
# The dashboard opens beside the agent only inside tmux, so a run starts its own session when
# tmux is installed. The window stays open after the run, so its last lines can be read.
if { [ "$cmd" = start ] || [ "$cmd" = resume ]; } && [ -z "${TMUX:-}" ] && [ -t 0 ] && command -v tmux >/dev/null; then
	# shellcheck disable=SC2016 # $0, $1 and $? are the inner bash's, not this script's
	exec tmux new-session -s "kyqs-ai-$$" bash -c '"$0" "$1"; printf "\nkyqs-ai exited (%s). Press Enter to close this window. " "$?"; read -r _' "$ROOT/kyqs-ai" "$cmd"
fi
case $cmd in
start) start ;;
add-local) add_local ;;
add-host) add_host "$@" ;;
add-cluster) add_cluster "$@" ;;
remove-cluster) remove_cluster "$@" ;;
hosts) hosts ;;
ssh-key) ssh_setup && base64 <"$KEY.pub" | tr -d '\n' && echo ;;
put-secret) put_secret "$@" ;;
dashboard) "$ROOT/bin/dashboard" "${1:-$(latest_run)}" ;;
resume) resume ;;
handover) "$ROOT/bin/handover" "${1:-$(latest_run)}" ;;
revoke) revoke "$@" ;;
-h | --help | help) usage ;;
*)
	usage >&2
	exit 2
	;;
esac
