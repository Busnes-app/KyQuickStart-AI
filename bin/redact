#!/bin/sh
# Best-effort mask for secrets in log output: `... docker compose logs | ./bin/redact`.
# A backstop only; the rule is still never to print a secret.
exec sed -E \
	-e 's/((pass(word)?|Pass(word)?|PASS(WORD)?|secret|Secret|SECRET|token|Token|TOKEN|key|Key|KEY)[A-Za-z_]*["'"'"']?[[:space:]]*[:=][[:space:]]*["'"'"']?)[^"'"'"'[:space:],}|]+/\1[redacted]/g' \
	-e 's/(Bearer|Basic) [A-Za-z0-9._~+\/=-]+/\1 [redacted]/g'
